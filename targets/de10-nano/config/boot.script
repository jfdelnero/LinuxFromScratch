mmc rescan
if fatload mmc 0:1 $kernel_addr_r soc_system.rbf; then echo -- Programming FPGA -- ;fpga load 0 $fileaddr $filesize; bridge enable; fi

mmc rescan
setenv bootargs 'console=ttyS0,115200 root=/dev/mmcblk0p2 rw rootwait' 
if fatload mmc 0:1 $kernel_addr_r zImage ; then if fatload mmc 0:1 $fdt_addr_r    soc_system.dtb; then bootz $kernel_addr_r - $fdt_addr_r; fi ; fi

